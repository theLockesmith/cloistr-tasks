# nginx resolves a proxy_pass upstream AT STARTUP when the address is written
# as a literal. The backend Service name only resolves inside the cluster, so
# the image refused to boot anywhere else with:
#
#   [emerg] host not found in upstream
#           "cloistr-tasks-backend.cloistr.svc.cluster.local"
#
# That made the CI smoke gate structurally unpassable, and in production it
# means a transient DNS failure while a pod starts is fatal rather than retried.
#
# Putting the upstream in a VARIABLE defers resolution to request time, so nginx
# starts regardless and an unreachable backend degrades to a 502 on /api/
# instead of preventing the app from serving at all.

server {
    listen 8080;

    # Populated by the image's 15-local-resolvers.envsh from /etc/resolv.conf.
    # That script is GATED on NGINX_ENTRYPOINT_LOCAL_RESOLVERS being set, which
    # the Dockerfile does. Without the gate the variable stays unsubstituted and
    # nginx dies with a "host not found in resolver" error naming the literal
    # placeholder text. (Do not write that placeholder out here: envsubst would
    # rewrite this comment too.)
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    location /api/ {
        # proxy_pass with a variable and NO URI part passes the original request
        # URI through unchanged, which matches the previous literal behaviour.
        set $upstream_backend "${TASKS_BACKEND_HOST}";
        proxy_pass http://$upstream_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Runtime service config for the shared reader in @cloistr/collab-common
    # (window.__CLOISTR_CONFIG__). The CLOISTR_* values are substituted at
    # container start, so one image serves production and staging.
    #
    # Exact match ("location =") so no current or future regex location for
    # static assets can outrank it and hand it a long cache; no-store so no
    # browser or edge cache serves one environment's config to the other.
    location = /config.js {
        access_log off;
        default_type application/javascript;
        add_header Cache-Control "no-store" always;
        return 200 'window.__CLOISTR_CONFIG__={"relayUrl":"${CLOISTR_RELAY_URL}","blossomUrl":"${CLOISTR_BLOSSOM_URL}","discoveryUrl":"${CLOISTR_DISCOVERY_URL}","signerUrl":"${CLOISTR_SIGNER_URL}","appUrl":"${CLOISTR_APP_URL}","environment":"${CLOISTR_ENVIRONMENT}"};';
    }

    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }
}
